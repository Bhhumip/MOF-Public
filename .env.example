PORT=3000
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-me
SHOPIFY_API_VERSION=2026-01
SHOPIFY_WEBHOOK_SECRET=replace-me
REDBOX_API_ENDPOINT=
ARAMEX_SOAP_ENDPOINT=https://ws.dev.aramex.net/shippingapi.v2/shipping/service_1_0.svc
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_VERSION=v1
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=
ARAMEX_SOURCE=24
ARAMEX_PRODUCT_GROUP=DOM
ARAMEX_PRODUCT_TYPE=OND
ARAMEX_PAYMENT_TYPE=P
ARAMEX_PAYMENT_OPTIONS=
ARAMEX_PARCEL_CM=10x10x10
ARAMEX_WAREHOUSE_PHONE=
ARAMEX_WAREHOUSE_EMAIL=
CARRIER_MODE=dry-run #sandbox/dry-run/live

# Tracking is a separate service. 
ARAMEX_TRACKING_ENDPOINT=
ARAMEX_TRACKING_MODE=poll
ARAMEX_POLL_INTERVAL_MS=900000
ARAMEX_USE_FOREIGN_HAWB=true
ARAMEX_UTC_OFFSET_MINUTES=180
ARAMEX_PICKUP_OPEN_HOUR=9
ARAMEX_PICKUP_LAST_HOUR=17
ARAMEX_PICKUP_CLOSE_HOUR=18
ARAMEX_PICKUP_LEAD_MINUTES=120
ARAMEX_PICKUP_CLOSED_DAYS=5
ARAMEX_STATUS_MAP=
ARAMEX_STATUS_HEURISTICS=true

# --- Safety guards ---
TEST_ORDER_TAG=MOF-TEST
ALLOWED_SHOPIFY_STORE=
POLLER_ENABLED=true

# --- Production hosting / recovery ---
HOST=127.0.0.1
JOB_STORE=mongodb
MONGODB_URI=
MONGODB_DATABASE=mof_return_orchestration
STUCK_JOB_MINUTES=15
RECONCILE_ENABLED=true
RECONCILE_LOOKBACK_HOURS=24